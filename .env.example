# 电动力学 AI 助教 —— 环境变量模板
# ---------------------------------------------------------------------------
# 复制为 .env 后填入自己的密钥：
#   cp .env.example .env       （Windows: copy .env.example .env）
#
# .env 已在 .gitignore 中排除，不会被提交。仓库里任何位置都不应出现真实密钥。

# ============================ 对话模型（必需） ============================
# 用于概念答疑、诊断与引导。到 https://open.bigmodel.cn 申请。
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash

# ============================ 视觉模型（拍照解题必需） ============================
# 题目照片识别。与上面的 GLM_API_KEY 共用同一个 Key，无需单独申请。
# 可选：glm-4v-plus（推荐）、glm-4.5v、glm-4v、glm-4v-flash
GLM_VISION_MODEL=glm-4v-plus

# ============================ MinerU（可选） ============================
# 文档解析：PDF / 扫描件转结构化文本，仅用于试卷与教材批量导入。
# 当前没有任何界面使用它，不填也不影响任何功能。
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4

# ============================ 服务端口 ============================
PORT=3200

# ============================ Kuzu 库文件目录（可选） ============================
# Kuzu 原生层只接受纯 ASCII 路径，库文件默认放在 %LOCALAPPDATA%\em-tutor\。
# 若默认位置不可用，可在此指定一个纯 ASCII 目录。
# EM_KUZU_DIR=D:\em-tutor-data
