# ============================ 密钥（最优先） ============================
# 任何形式的密钥文件都不进版本库
.env
.env.*
!.env.example
*.pem
*.key

# ============================ 依赖与构建产物 ============================
node_modules/
dist/
dist-server/

# ============================ 数据库（派生数据） ============================
# Kuzu 库由 npm run ingest 从 data/*.json 重建，不纳入版本管理
data/*.db
data/*.db.wal
data/*.db.lock
data/*.db.tmp

# ============================ 日志与系统文件 ============================
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# ============================ 编辑器 ============================
.vscode/
.idea/
*.swp

# ============================ 本地草稿与截图 ============================
screenshots/
